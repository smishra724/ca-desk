{
  "manifest_version": 3,
  "name": "CA Desk Helper",
  "version": "1.2.1",
  "description": "CA Desk helper: fills portal logins (you type CAPTCHA/OTP), reads GST data from Tally on this computer, and runs the GSTR-1 upload autopilot up to Generate summary.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://smishra724.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.gst.gov.in/*",
        "https://ewaybillgst.gov.in/*",
        "https://*.incometax.gov.in/*",
        "https://www.tdscpc.gov.in/*",
        "https://*.mca.gov.in/*",
        "https://*.epfindia.gov.in/*",
        "https://*.esic.gov.in/*",
        "https://udyamregistration.gov.in/*",
        "https://*.dgft.gov.in/*"
      ],
      "js": [
        "fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.gst.gov.in/*"
      ],
      "js": [
        "gstauto.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}