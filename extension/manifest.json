{
  "manifest_version": 3,
  "name": "CA Desk Helper",
  "key": "",
  "version": "1.6.0",
  "description": "CA Desk helper: portal login autofill (you type CAPTCHA/OTP), Tally data on this computer, and the GSTR-1 autopilot: upload JSON, generate summary, and after you file, save the ARN and PDF to CA Desk, and checks GST return filing frequency (you type the CAPTCHA). Reads DSC token details on this computer (with the CA Desk DSC helper) to fill the DSC register.",
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://smishra724.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.gst.gov.in/*",
        "https://ewaybillgst.gov.in/*",
        "https://*.incometax.gov.in/*",
        "https://www.tdscpc.gov.in/*",
        "https://*.mca.gov.in/*",
        "https://*.epfindia.gov.in/*",
        "https://*.esic.gov.in/*",
        "https://udyamregistration.gov.in/*",
        "https://*.dgft.gov.in/*"
      ],
      "js": [
        "fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.gst.gov.in/*"
      ],
      "js": [
        "gstauto.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://return.gst.gov.in/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://services.gst.gov.in/services/searchtp*"
      ],
      "js": [
        "freq.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.gst.gov.in/*",
    "https://smishra724.github.io/*"
  ]
}